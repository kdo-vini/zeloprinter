{
  "name": "zelo-impressao",
  "version": "0.2.0",
  "private": true,
  "author": "Techne Sistemas",
  "description": "Componente local do Zelo para impressao automatica de comprovantes, pedidos e comandas.",
  "repository": {
    "type": "git",
    "url": "https://github.com/kdo-vini/zeloprinter.git"
  },
  "type": "module",
  "scripts": {
    "test": "npm run test:sdk && npm run test:native",
    "test:sdk": "node --test tests/*.test.mjs",
    "test:native": "dotnet run --project native/ZeloImpressao.Tests -c Release",
    "build": "npm run dotnet:build",
    "pack:win": "npm run dotnet:publish:win && iscc .\\native\\installer\\ZeloImpressao.iss",
    "dotnet:build": "npm run version:sync && dotnet build .\\native\\ZeloImpressao\\ZeloImpressao.csproj -c Release",
    "dotnet:publish:win": "npm run version:sync && powershell -ExecutionPolicy Bypass -File ./native/build/Build-Windows.ps1",
    "sdk:prepare": "node ./scripts/prepare-browser-sdk.mjs",
    "version:sync": "node ./scripts/version-manager.mjs sync",
    "version:set": "node ./scripts/version-manager.mjs set",
    "version:bump:patch": "node ./scripts/version-manager.mjs bump patch",
    "version:bump:minor": "node ./scripts/version-manager.mjs bump minor",
    "version:bump:major": "node ./scripts/version-manager.mjs bump major"
  }
}
